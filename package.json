{
	"name": "@workiom/n8n-nodes-workiom",
	"version": "0.4.8",
	"description": "n8n community node for the Workiom no-code platform",
	"license": "MIT",
	"homepage": "https://workiom.com",
	"keywords": [
		"n8n-community-node-package",
		"workiom",
		"no-code",
		"automation"
	],
	"author": {
		"name": "Workiom",
		"email": "support@workiom.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/workiom/n8n-nodes-workiom.git"
	},
	"scripts": {
		"build": "n8n-node build && rm -f dist/tsconfig.tsbuildinfo",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WorkiomApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Workiom/Workiom.node.js",
			"dist/nodes/Workiom/WorkiomTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.37.2",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
